# Copy this file to `.env` and fill in your real values.
# NEVER commit .env — it contains secrets.

# Server port
PORT=5000

# MongoDB connection string (MongoDB Atlas recommended)
MONGO_URI=mongodb://127.0.0.1:27017/opportunity-radar

# JWT secret for the email/password auth
JWT_SECRET=change_me_in_production

# Comma-separated list of allowed browser origins for CORS.
# Leave empty (or use *) to allow all origins during development.
CORS_ORIGIN=http://localhost:5173

# ---------- AI / embeddings ----------
NVIDIA_API_KEY=
NVIDIA_EMBED_API_KEY=
GEMINI_API_KEY=

# ---------- Vector search (Pinecone) ----------
PINECONE_API_KEY=
# Optional: custom index name (defaults to prime-opportunity-index)
PINECONE_INDEX_NAME=

# ---------- Mentorship checkout ----------
# Paystack public key for the mentorship checkout page.
# Leave empty to keep checkout in demo mode (no real charges).
PAYSTACK_PUBLIC_KEY=
# Fee charged per mentorship guidance session
MENTORSHIP_FEE=20000
MENTORSHIP_CURRENCY=NGN

# Bootstrap Admins: comma-separated Firebase UIDs that are forced to be admins.
# The very first AppUser synced also becomes an admin automatically.
ADMIN_UIDS=

# ---------- Opportunity sync (daily updates) ----------
# node-cron schedule + timezone for the automatic sync
SYNC_CRON=0 6 * * *
SYNC_TIMEZONE=Africa/Lagos

# ScholarshipAPI (leave SCHOLARSHIP_API_KEY empty to skip - no-auth mode)
SCHOLARSHIP_API_KEY=
SCHOLARSHIP_API_BASE_URL=https://api.scholarshipapi.com/v1/scholarships
SCHOLARSHIP_API_PER_PAGE=100
SCHOLARSHIP_API_PAGES=5
SCHOLARSHIP_API_KEY_HEADER=api-key
SCHOLARSHIP_API_USE_QUERY=false

# Adzuna (leave ADZUNA_APP_ID/ADZUNA_APP_KEY empty to skip - no-auth mode)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
ADZUNA_KEYWORD=internship graduate trainee
ADZUNA_PER_PAGE=50
ADZUNA_PAGES=3

# RSS niche feeds (comma-separated); built-in defaults used when empty
RSS_FEEDS=

# Number of pages scraped per sync (default 2 each)
SCHOLARSHIP_AIR_PAGES=2
SCHOLARSHIP_TAB_PAGES=2

# ---------- Parse.bot (Scholarships.com API via Parse) ----------
PARSE_API_KEY=
PARSE_SCHOLARSHIP_SCRAPER_ID=
# Comma-separated directory categories to crawl each sync
PARSE_CATEGORIES=academic-major,deadline
PARSE_SUBCATEGORIES_PER_CATEGORY=2
PARSE_MAX_LISTINGS=100
# Max get_scholarship_detail calls per sync (1 credit each)
PARSE_MAX_DETAILS=20
PARSE_CALL_DELAY=500